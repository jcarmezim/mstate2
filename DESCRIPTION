Package: mstate2
Type: Package
Title: Second-Order Markov Multistate Models
Version: 0.2.0
Authors@R: c(
    person("João", "Carmezim", role = c("aut", "cre"),
           email = "joaocarmezimcorreia@gmail.com"),
    person("Josu", "Najera-Zuloaga", role = "aut",
           email = "josu.najera@ehu.eus"),
