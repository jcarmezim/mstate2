```{r, include = FALSE}
knitr::opts_chunk$set(collapse = TRUE, comment = "#>", fig.width = 7, fig.height = 4.2,
                      fig.align = "center", fig.path = "figures/guide-", dpi = 96)
options(width = 90, digits = 4)
divine_path <- Sys.getenv("MSTATE2_DIVINE_DATA", "MSM_Data.RData")
